programa
{
	
	funcao inicio()
	{
		cadeia nome
		escreva("Qual é o seu nome? ")
		leia(nome)
		escreva ("Olá " + nome + ", é um prazer te conhecer. ")
		inteiro idade = 25
		real peso = 96.0
		caracter sexo = 'M'
		logico casado = verdadeiro
	}
}
